# Local secrets / env
.env
.env.local
.env.*.local
# Production env rendered from deploy/env.prod.example (per
# doc/burn-in-preflight.md §A.2 — every secret must use *_REF; raw
# values must never be committed).
.env.prod
# Staging sandbox env rendered from deploy/env.staging.example — local
# docker run only; raw secrets allowed (single-host sandbox).
deploy/env.staging

# Postgres data (volume mount)
data/

# Docker volumes
.docker-data/

# Skill pack trust store — priv keys never enter the repo
# `**/.qzdap/...` matches anywhere in the tree (backend/.qzdap/, frontend/.qzdap/,
# or a future top-level .qzdap/). The inner `**` then matches nested
# trust subdirs (e.g. backend/.qzdap/skill-trust/*.priv.pem). Public keys
# (*.pub.pem) remain trackable so shared dev trust stores can be committed.
**/.qzdap/**/*.priv.pem
**/.qzdap/**/*.priv
# Real SecretProviderClass / Secret rendered from infra/k8s/secret.example.yaml
# (per doc/burn-in-preflight.md §A.4 — gitleaks G5 will catch any leak).
infra/k8s/secret.yaml
infra/k8s/staging/secret.yaml

# ── Frontend (pnpm + Vite + TS) ────────────────────────────────────────────
# Frontend lives under frontend/ — pnpm workspace with web/ + packages/*.
# Source frontend/.gitignore handles package-local ignores; these root-level
# patterns are a defense-in-depth layer for tooling that walks the repo root.
frontend/**/node_modules/
frontend/**/dist/
frontend/**/*.tsbuildinfo
frontend/**/.vite/
frontend/**/coverage/
frontend/**/.next/   # reserved for future Next.js migration
frontend/**/.cache/
frontend/web/.env.local
frontend/web/.env.*.local
frontend/**/*.log
frontend/.DS_Store
# Compiled JS siblings of package source TS — each package's "main" points
# to src/*.ts via vite alias, so .js siblings are stale tsc/swc artefacts.
# Source frontend/web/.gitignore covers web/ itself; this rule reaches the
# sibling frontend/packages/* subtree where local .gitignore can't.
frontend/packages/**/src/*.js

# Local pnpm content-addressable store (never commit)
.pnpm-store/

# Embedded / leftover local Postgres data directories
backend/.pgdata*/
backend/.pgdata-eos/

# Legacy skill-trust keys under .eos (priv never enter the repo)
**/.eos/**/*.priv.pem
**/.eos/**/*.priv

# QZDAP dev-stack runtime (logs + pid files; scripts checked in)
bin/qzdap-stack/logs/

# Monorepo workspaces install into nested node_modules
node_modules/
frontend/**/node_modules/
backend/.venv/
