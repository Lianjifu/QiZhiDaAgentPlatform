# 业务环境只允许 demo / development
VITE_QZDAP_ENV=development
# development-api：查询优先数据库，查询空或失败时使用开发 Mock；写入失败直接报错
# development-mock：前端纯 Mock，便于没有后端时开发页面
VITE_DATA_MODE=development-api
# 默认：真实 API（经 Vite 代理打到 QZDAP 网关 :9150 → qzdap-app）
VITE_USE_DEMO=false
VITE_USE_MOCK=false
# 推荐留空：浏览器请求同源 /api，由 Vite 代理到网关
VITE_API_BASE=

# 需要浏览器直连网关时再填写：
# VITE_API_BASE=http://127.0.0.1:9150
# VITE_API_DIRECT=true

# 代理目标（仅 Vite 进程读取）
# VITE_PROXY_TARGET=http://127.0.0.1:9150

# 演示环境（前端内存 Handler，可不启后端）：VITE_QZDAP_ENV=demo VITE_DATA_MODE=demo npm run dev
# VITE_USE_DEMO=true

# 跨标签会话同步（BFF / pmsop 联调时可关闭以避免噪音）
# VITE_SESSION_SYNC_ENABLED=false
