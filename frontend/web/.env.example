# ── 业务环境 —— 唯一的模式开关 ─────────────────────────────────────────
# development：所有查询和写入都走后端 API（Postgres / Redis），空数据或失败原样返回。
#              开发环境**不使用任何演示数据**。
# demo      ：演示环境。数据同样来自后端 API —— 只是那是个 QZDAP_ENV=demo 的
#              后端实例，连的是独立的演示库 qzdap_demo。
#              前端代码两边完全一样，没有"内存 mock 模式"。
# 没有别的开关 —— 演示模式只能靠这一行显式打开。
VITE_QZDAP_ENV=development

# 推荐留空：浏览器请求同源 /api，由 Vite 代理到网关
VITE_API_BASE=

# 需要浏览器直连网关时再填写：
# VITE_API_BASE=http://127.0.0.1:9150
# VITE_API_DIRECT=true

# 代理目标（仅 Vite 进程读取）
# VITE_PROXY_TARGET=http://127.0.0.1:9150

# 演示环境：VITE_QZDAP_ENV=demo npm run dev

# 跨标签会话同步（BFF / pmsop 联调时可关闭以避免噪音）
# VITE_SESSION_SYNC_ENABLED=false
