{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["vite/client", "node"],
    "paths": {
      "@/*": ["./src/*"],
      "@qzdap/web-ui": ["../packages/ui/src/index.tsx"],
      "@qzdap/web-api": ["../packages/api/src/index.ts"],
      "@qzdap/web-types": ["../packages/types/src/index.ts"],
      "@qzdap/web-hooks": ["../packages/hooks/src/index.ts"],
      "@qzdap/web-utils": ["../packages/utils/src/index.ts"]
    }
  },
  "include": ["src/**/*", "vite.config.ts"]
}