# 演示环境（demo）环境变量模板 — 不要提交真实密钥
#
# 演示环境是**独立的一套后端实例 + 独立的库**，跟开发环境、生产环境都分开：
#
#   开发：qzdap-dev 实例 → qzdap_dev 库 → Redis db 0
#   演示：qzdap-demo 实例 → qzdap_demo 库 → Redis db 1
#
# 前端代码两边完全一样（没有"内存 mock 模式"），区别只在
# ``VITE_QZDAP_ENV`` 和代理指向哪个实例。详见
# ``docs/demo-vs-api-data-separation.md``。
#
# 本地跑演示环境（推荐，别手动拼这些变量）：
#
#   bin/qzdap-stack/run-qzdap-demo-stack.sh     # 建库 → 迁移 → 种数据 → 起栈
#   bin/qzdap-stack/status-qzdap-demo-stack.sh  # 看状态
#   bin/qzdap-stack/stop-qzdap-demo-stack.sh    # 停
#
# 下面这份模板是**要把演示环境部署到服务器上**时用的 —— 跟
# ``env.prod.example`` 一样的 *_REF 密钥间接层。

QZDAP_ENV=demo
QZDAP_RING=stable

# ── 数据面：演示库跟开发库/生产库必须是两个库 ──────────────────────────
# 演示库绝对不能跟生产库是同一个 —— demo 种子会往里写演示智能体.
QZDAP_DATABASE_URL_REF=vault:secret/data/demo/qzdap/database_url
QZDAP_REDIS_URL_REF=vault:secret/data/demo/qzdap/redis_url

# ── JWT ────────────────────────────────────────────────────────────────
# 演示环境的 JWT 密钥跟生产**必须不同** —— 两边账号不共用.
QZDAP_JWT_SECRET_REF=csi:QZDAP_JWT_SECRET
QZDAP_JWT_ACCESS_TTL_SECONDS=3600

# ── 认证边界 ────────────────────────────────────────────────────────────
# 没有 token 的请求一律 401 (AuthRequiredMiddleware). 公开端点清单:
# 带 "*" 的是 glob 规则, 其余按精确路径匹配.
QZDAP_PUBLIC_PATHS=/healthz,/livez,/readyz,/metrics,/docs,/openapi.json,/v1/identity/login,/v1/identity/tenants,/v1/channels/*/webhook

# ── 演示身份 ────────────────────────────────────────────────────────────
# 这几个只在 QZDAP_ENV=demo 时被读到；开发/生产环境用不到。
# 演示库和开发库的租户、账号、密码全都不同 —— 这是拆分的核心.
QZDAP_DEMO_TENANT_ID=00000000-0000-0000-0000-000000000001
QZDAP_DEMO_TENANT_SLUG=demo
QZDAP_DEMO_ADMIN_EMAIL=admin@acme.com
QZDAP_DEMO_USER_EMAIL=user@acme.com
QZDAP_DEMO_PASSWORD=demo-password-change-me

# ── 模型 / 嵌入的加密主密钥 ────────────────────────────────────────────
QZDAP_MODEL_MASTER_KEY_REF=csi:QZDAP_MODEL_MASTER_KEY

# ── LLM 供应商 ──────────────────────────────────────────────────────────
# 演示对话要能真跑起来，就得在这里配一个**真实**的供应商.
# 上游模型 id 用 deepseek-chat —— 跟演示智能体的 model 字段对得上
# (见 composition/qzdap_app/.../seeds.py 的 DEMO_AGENT_MODEL).
QZDAP_LLM_PROVIDER=openai
QZDAP_OPENAI_API_KEY_REF=csi:QZDAP_OPENAI_API_KEY

# ── 观测 ────────────────────────────────────────────────────────────────
QZDAP_LOG_LEVEL=INFO
QZDAP_LOG_JSON=false
