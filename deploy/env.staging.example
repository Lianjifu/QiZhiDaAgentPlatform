# Staging sandbox env — single-host docker run, no compose.
# Copy to deploy/env.staging (gitignored) and tweak.
#
# Sandbox deliberately avoids Vault / CSI / Kafka / OpenAI: vault_mode=noop
# so the boot-time *_REF resolver (composition/qzdap_app/.../ref_resolver.py)
# is a no-op for the regular fields.  We still wire ONE *_REF (QZDAP_OPENAI_API_KEY)
# via the env: scheme to verify the resolver actually fires in the container —
# watch the boot log for "resolved 1 QZDAP_*_REF env vars".

QZDAP_ENV=staging
QZDAP_RING=stable
QZDAP_LOG_LEVEL=INFO

# Database — points at the postgres container on the qzdap-staging network.
QZDAP_DATABASE_URL=postgresql+asyncpg://qzdap:qzdap@postgres:5432/qzdap

# Redis is not started in the sandbox; event bus is inprocess.
QZDAP_REDIS_URL=redis://localhost:6379/0

# JWT — sandbox only, NEVER reuse in any non-sandbox env.
QZDAP_JWT_SECRET=dev-jwt-secret-change-me-in-real-deployments
QZDAP_JWT_ACCESS_TTL_SECONDS=3600
QZDAP_BAN_MOCK_TOKEN=1
QZDAP_ALLOW_DEMO_TOKEN=0

# LLM provider — mock means no external calls during the sandbox run.
QZDAP_LLM_PROVIDER=mock

# Vault mode — noop skips resolver instantiation.  The single *_REF below
# still runs through ref_resolver.py because *_REF vars are processed before
# vault_mode is consulted.
QZDAP_VAULT_MODE=noop

# Audit + event bus — direct + inprocess keeps the sandbox self-contained.
QZDAP_AUDIT_MODE=direct
QZDAP_AUDIT_CONSUMER_ENABLED=false
QZDAP_EVENT_BUS=inprocess

# Skill runtime
QZDAP_SANDBOX_MODE=local
QZDAP_SKILL_RUNTIME_URL=http://127.0.0.1:8093

# Object storage — empty; knowledge assets write to local fs.
QZDAP_OBJECT_STORAGE_URL=

# Observability — empty in sandbox.
QZDAP_OTLP_ENDPOINT=
QZDAP_SENTRY_DSN=

# Gunicorn — 2 workers is enough for one sandbox pod.
QZDAP_GUNICORN_WORKERS=2
QZDAP_GUNICORN_THREADS=2
QZDAP_GUNICORN_TIMEOUT=60

# Ref-resolver smoke: validate composition/qzdap_app/.../ref_resolver.py
# boots + dispatches env: scheme.  INNER_OPENAI_KEY is the canonical name,
# QZDAP_OPENAI_API_KEY is unset on purpose so the resolver must write it.
INNER_OPENAI_KEY=sk-test-sandbox-not-real
QZDAP_OPENAI_API_KEY_REF=env:INNER_OPENAI_KEY