# Production environment template — DO NOT COMMIT REAL SECRETS
# Copy to ../.env.prod.  All *_REF values are resolved at startup by
# libs/vault via ``composition/qzdap_app/.../ref_resolver.py`` before
# Pydantic reads env.  Two schemes are supported out of the box:
#
#   vault:secret/data/<path>     HashiCorp Vault KV v2 lookup
#                                (consumed by HashicorpVaultSecretsResolver)
#   csi:<KEY_NAME>               read /vault/secrets/<KEY_NAME> mounted by
#                                the Vault CSI driver
#                                (consumed by CSIVaultSecretsResolver)
#
# See infra/k8s/secret.example.yaml for the matching SecretProviderClass
# template and deploy/README.md for the rollout sequence.
#
# Required setting: ``QZDAP_VAULT_MODE=csi`` (or ``vault`` if you prefer the
# HashiCorp Vault path) — the resolver reads ``vault_mode`` from Pydantic
# Settings but the *_REF boot resolver instantiates each backend on its
# own (no dependency on vault_mode).

QZDAP_ENV=production
QZDAP_RING=stable

# Database — secret ref only (vault supplies real password)
QZDAP_DATABASE_URL_REF=vault:secret/data/prod/qzdap/database_url
QZDAP_REDIS_URL_REF=vault:secret/data/prod/qzdap/redis_url

# JWT (CSI-mounted so the secret never appears as env)
QZDAP_JWT_SECRET_REF=csi:QZDAP_JWT_SECRET
QZDAP_JWT_ACCESS_TTL_SECONDS=3600
QZDAP_BAN_MOCK_TOKEN=1
QZDAP_ALLOW_DEMO_TOKEN=0

# Vault master keys for model / channel credentials (AES-GCM)
QZDAP_MODEL_MASTER_KEY_REF=csi:QZDAP_MODEL_MASTER_KEY

# Sandbox / run-token
QZDAP_RUN_TOKEN_SECRET_REF=csi:QZDAP_RUN_TOKEN_SECRET
QZDAP_SANDBOX_MODE=remote
QZDAP_SKILL_RUNTIME_URL=http://skill-runtime:8093

# LLM provider
QZDAP_LLM_PROVIDER=openai
QZDAP_OPENAI_API_KEY_REF=csi:QZDAP_OPENAI_API_KEY

# Observability
QZDAP_LOG_LEVEL=INFO
QZDAP_OTLP_ENDPOINT_REF=vault:secret/data/prod/qzdap/otlp_endpoint

# Gunicorn tuning
QZDAP_GUNICORN_WORKERS=4
QZDAP_GUNICORN_THREADS=2
QZDAP_GUNICORN_TIMEOUT=60

# ── Distributed runtime (P10) ─────────────────────────────────────────────
# Audit pipeline (A5) — kafka replaces the synchronous SqlAuditLogAdapter
# for the prod hot path.  Canary pods set AUDIT_CONSUMER_ENABLED=false so
# only the stable pool drains the topic (no double-write to audit_log).
QZDAP_AUDIT_MODE=kafka
QZDAP_AUDIT_KAFKA_BOOTSTRAP_SERVERS=kafka.prod.svc.cluster.local:9092
QZDAP_AUDIT_KAFKA_TOPIC=qzdap.audit.events
QZDAP_AUDIT_KAFKA_DLQ_TOPIC=qzdap.audit.events.dlq
QZDAP_AUDIT_CONSUMER_ENABLED=true

# Event bus — redis-stream is required for multi-replica fan-out; the
# default in-process bus only works for the single-pod dev profile.
QZDAP_EVENT_BUS=redis-stream

# HashiCorp Vault resolver knobs (only consulted when QZDAP_*_REF starts
# with the ``vault:`` scheme; ignored otherwise)
# QZDAP_VAULT_URL=https://vault.internal:8200
# QZDAP_VAULT_MOUNT=secret

# ── Pack signing (Tier B) ────────────────────────────────────────────────
# Skill vetter — vault mode in prod pulls pubkeys from Vault KV v2.
# Knowledge / Plan vetters use local trust dirs mounted into the
# container at the path below.
QZDAP_SKILL_SIGNING_MODE=vault
QZDAP_SKILL_TRUST_DIR=/etc/qzdap/skill-trust
QZDAP_VAULT_SKILL_TRUST_REF=vault:secret/data/prod/qzdap/skill-trust/keys
QZDAP_VAULT_SKILL_TRUST_REFRESH_SECONDS=300
QZDAP_VAULT_SKILL_TRUST_MIN_KEYS=1
QZDAP_KNOWLEDGE_SIGNING_MODE=local
QZDAP_KNOWLEDGE_TRUST_DIR=/etc/qzdap/knowledge-trust
QZDAP_PLAN_SIGNING_MODE=local
QZDAP_PLAN_TRUST_DIR=/etc/qzdap/plan-trust

# ── Office pack seeders (Tier B) ─────────────────────────────────────────
QZDAP_PLATFORM_SEED_OFFICE_SKILL_PACKS=true
QZDAP_PLATFORM_OFFICE_SKILL_PACKS_ROOT=/srv/qzdap/packs/office/skills
QZDAP_PLATFORM_SEED_OFFICE_KNOWLEDGE_PACKS=true
QZDAP_PLATFORM_OFFICE_KNOWLEDGE_PACKS_ROOT=/srv/qzdap/packs/office/knowledge
QZDAP_PLATFORM_SEED_OFFICE_PLAN_PACKS=true
QZDAP_PLATFORM_OFFICE_PLAN_PACKS_ROOT=/srv/qzdap/packs/office/plans
