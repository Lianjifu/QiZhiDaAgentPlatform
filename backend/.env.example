# 企智搭 · 智能体平台 — environment variables
# All variables MUST be prefixed with QZDAP_. Copy to .env and fill in real values.
# NEVER commit .env; only .env.example is tracked.

# ── Core ────────────────────────────────────────────────────────────────
QZDAP_ENV=development                                    # development | test | ci | staging | production
QZDAP_DEBUG=true
QZDAP_LOG_LEVEL=INFO                                     # DEBUG | INFO | WARNING | ERROR
QZDAP_LOG_JSON=true                                      # true for non-dev; false for dev readability

# ── HTTP server ─────────────────────────────────────────────────────────
QZDAP_HTTP_HOST=0.0.0.0
QZDAP_HTTP_PORT=8100
QZDAP_HTTP_WORKERS=1
QZDAP_HTTP_REQUEST_BODY_MAX_BYTES=10485760               # 10 MB

# ── Database ────────────────────────────────────────────────────────────
QZDAP_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/qzdap_dev
QZDAP_DATABASE_POOL_SIZE=20
QZDAP_DATABASE_MAX_OVERFLOW=10
QZDAP_DATABASE_POOL_RECYCLE=3600
QZDAP_DATABASE_ECHO=false

# ── Redis ───────────────────────────────────────────────────────────────
QZDAP_REDIS_URL=redis://localhost:6379/0
QZDAP_REDIS_MAX_CONNECTIONS=50

# ── Object storage (MinIO dev / S3 prod) ────────────────────────────────
QZDAP_OBJECT_STORAGE_ENDPOINT=http://localhost:9000
QZDAP_OBJECT_STORAGE_REGION=us-east-1
QZDAP_OBJECT_STORAGE_ACCESS_KEY=minioadmin
QZDAP_OBJECT_STORAGE_SECRET_KEY=minioadmin
QZDAP_OBJECT_STORAGE_BUCKET=qzdap-dev
QZDAP_OBJECT_STORAGE_SECURE=false

# ── Auth ────────────────────────────────────────────────────────────────
# Dev secret — replace via secret manager in staging/prod.
QZDAP_JWT_SECRET=dev-secret-not-for-production-use-only
QZDAP_JWT_ALGORITHM=HS256
QZDAP_JWT_ISSUER=qzdap-dev
QZDAP_JWT_AUDIENCE=qzdap-api
QZDAP_JWT_ACCESS_TTL_SECONDS=3600
QZDAP_API_KEY_HASH_ROUNDS=12

# ── Multi-tenancy ───────────────────────────────────────────────────────
# Stricter in non-dev. CI/peer review: QZDAP_BAN_MOCK_TOKEN must be 1 in CI.
QZDAP_BAN_MOCK_TOKEN=0
QZDAP_ALLOW_DEMO_TOKEN=1
QZDAP_DEMO_TENANT_ID=00000000-0000-0000-0000-000000000001

# ── LLM ─────────────────────────────────────────────────────────────────
QZDAP_LLM_PROVIDER=mock                                  # mock | openai | anthropic | deepseek
QZDAP_LLM_BASE_URL=https://api.openai.com/v1
QZDAP_LLM_API_KEY=                                       # leave empty for mock; required for real providers
QZDAP_LLM_DEFAULT_MODEL=gpt-4o-mini
QZDAP_LLM_TIMEOUT_SECONDS=30
QZDAP_LLM_MOCK_LATENCY_MS=50
QZDAP_LLM_FAILOVER_PROVIDERS=                            # comma-separated; e.g. anthropic,deepseek
QZDAP_LLM_EMBEDDING_MODEL=text-embedding-3-small
QZDAP_LLM_EMBEDDING_DIM=1536

# ── Sandbox runtime (gVisor sidecar) ────────────────────────────────────
QZDAP_SANDBOX_RUNTIME_URL=http://127.0.0.1:8093
QZDAP_SANDBOX_RUNTIME_SECRET=dev-sandbox-runtime-secret-change-me
QZDAP_SANDBOX_DEFAULT_IMAGE=qzdap/sandbox-python:latest
QZDAP_SANDBOX_EXECUTOR=gvisor
QZDAP_SANDBOX_IMAGES=qzdap/sandbox-python:latest
QZDAP_SANDBOX_DOCKER_SOCKET=/var/run/docker.sock

# ── Vector store ────────────────────────────────────────────────────────
QZDAP_VECTOR_PROVIDER=pgvector                           # pgvector | milvus
QZDAP_VECTOR_PGVECTOR_TABLE=memory_embeddings
QZDAP_VECTOR_MILVUS_HOST=
QZDAP_VECTOR_MILVUS_PORT=19530

# ── Event bus ───────────────────────────────────────────────────────────
QZDAP_EVENT_BUS=inprocess                                # inprocess | redis-stream
QZDAP_EVENT_REDIS_STREAM_PREFIX=qzdap:events:
QZDAP_EVENT_DLQ_STREAM=qzdap:events:dlq
# Consumer name resolution: explicit arg > QZDAP_EVENT_REDIS_CONSUMER_NAME env > hostname > uuid4.
# In k8s, set POD_NAME here so each replica has its own consumer-group slot.
QZDAP_EVENT_REDIS_CONSUMER_NAME=
QZDAP_EVENT_REDIS_MAX_RETRIES=3
QZDAP_EVENT_REDIS_BLOCK_MS=1000
QZDAP_EVENT_REDIS_COUNT=10

# ── Audit pipeline (A5) ──────────────────────────────────────────────────
# ``direct`` keeps the synchronous SqlAuditLogAdapter path (default —
# backward compatible). ``kafka`` routes audit events through
# KafkaAuditPublisher → qzdap.audit.events → KafkaAuditConsumer → audit_log.
QZDAP_AUDIT_MODE=direct                                 # direct | kafka
# When ``kafka``, set false on N-1 k8s replicas so only one drains.
QZDAP_AUDIT_CONSUMER_ENABLED=true
QZDAP_AUDIT_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
QZDAP_AUDIT_KAFKA_TOPIC=qzdap.audit.events
QZDAP_AUDIT_KAFKA_DLQ_TOPIC=qzdap.audit.events.dlq
# Consumer group resolution: explicit > QZDAP_AUDIT_KAFKA_CONSUMER_GROUP env > hostname > uuid4.
# In k8s, set POD_NAME so each replica has its own offset track.
QZDAP_AUDIT_KAFKA_CONSUMER_GROUP=
QZDAP_AUDIT_KAFKA_MAX_RETRIES=3
QZDAP_AUDIT_KAFKA_BLOCK_MS=1000
QZDAP_AUDIT_KAFKA_REQUEST_TIMEOUT_MS=5000

# ── Rate limiting ───────────────────────────────────────────────────────
QZDAP_RATE_LIMIT_PER_TENANT_PER_MIN=1000
QZDAP_RATE_LIMIT_PER_API_KEY_PER_MIN=1000
QZDAP_RATE_LIMIT_WINDOW_SECONDS=60

# ── CORS ────────────────────────────────────────────────────────────────
QZDAP_CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:3000
QZDAP_CORS_ALLOW_CREDENTIALS=true
QZDAP_CORS_ALLOW_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
QZDAP_CORS_ALLOW_HEADERS=*

# ── Observability ───────────────────────────────────────────────────────
QZDAP_OTLP_ENDPOINT=                                     # empty disables remote export; e.g. http://otel-collector:4317
QZDAP_METRICS_PATH=/metrics
QZDAP_TRACES_SAMPLE_RATE=1.0
QZDAP_SENTRY_DSN=                                        # empty disables Sentry
QZDAP_SENTRY_SAMPLE_RATE=0.1

# ── Memory expiry task ──────────────────────────────────────────────────
QZDAP_MEMORY_EXPIRY_INTERVAL_SECONDS=300

# ── Skill catalog ───────────────────────────────────────────────────────
# disabled = NoOpSkillVetter (dev/test opt-out, NEVER in prod)
# local    = LocalTrustStoreSkillVetter; boot fails if trust dir missing/empty
# vault    = VaultBackedSkillVetter (Tier B) — pulls keys from Vault KV v2
QZDAP_SKILL_SIGNING_MODE=local
QZDAP_SKILL_TRUST_DIR=./.qzdap/skill-trust

# Vault-backed skill trust store (Tier B).  All values are *refs*; the
# raw secret never lives in the env.  QZDAP_VAULT_TOKEN itself must also
# be supplied as a ref to the platform secrets table.
QZDAP_VAULT_SKILL_TRUST_REF=vault:secret/data/qzdap/skill-trust/keys
QZDAP_VAULT_SKILL_TRUST_REFRESH_SECONDS=300
QZDAP_VAULT_SKILL_TRUST_MIN_KEYS=1

# ── Knowledge signing (Tier B) ───────────────────────────────────────────
# disabled = NoOpKnowledgeVetter; local = LocalTrustStoreKnowledgeVetter.
# (vault-mode for knowledge is out of scope for Tier B.)
QZDAP_KNOWLEDGE_SIGNING_MODE=local
QZDAP_KNOWLEDGE_TRUST_DIR=./.qzdap/knowledge-trust

# ── Plan signing (Tier B) ────────────────────────────────────────────────
# disabled = NoOpPlanVetter; local = LocalTrustStorePlanVetter.
QZDAP_PLAN_SIGNING_MODE=local
QZDAP_PLAN_TRUST_DIR=./.qzdap/plan-trust

# ── Office pack seeders (A6 / Tier B) ────────────────────────────────────
# Walks the configured root at lifespan boot and registers every
# <pack>/{manifest.json, signature.json} via the matching use case
# (vetter-gated). Set false to disable individually.
QZDAP_PLATFORM_SEED_OFFICE_SKILL_PACKS=true
QZDAP_PLATFORM_OFFICE_SKILL_PACKS_ROOT=packs/office/skills
QZDAP_PLATFORM_SEED_OFFICE_KNOWLEDGE_PACKS=true
QZDAP_PLATFORM_OFFICE_KNOWLEDGE_PACKS_ROOT=packs/office/knowledge
QZDAP_PLATFORM_SEED_OFFICE_PLAN_PACKS=true
QZDAP_PLATFORM_OFFICE_PLAN_PACKS_ROOT=packs/office/plans